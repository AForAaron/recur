    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "订阅"
      },
      {
        "pagePath": "pages/stats/stats",
        "text": "统计"
      },
      {
        "pagePath": "pages/settings/settings",
        "text": "我的"
      }
    ]
  },
  "easycom": {
    "^u-(.*)": "uview-plus/components/u-$1/u-$1.vue"
  }
}
